  {
   "id": "te11",
   "type": "text",
   "x": 54,
   "y": 921,
   "width": 572,
   "height": 234,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1198704004,
   "version": 1,
   "versionNonce": 3577444,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Funcionais\n• Responder com base nos documentos e citar a fonte\n• Dizer \"não sei\" e passar para um atendente\n• Guardar o histórico da conversa\n• Botão útil / não útil em cada resposta\n\nNão funcionais\n• Latência: 2 s para começar, 8 s no total (streaming)\n• Disponibilidade: 99,9%\n• LGPD: mascarar dados pessoais\n• Custo por conversa conhecido e acompanhado",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "re10",
   "originalText": "Funcionais\n• Responder com base nos documentos e citar a fonte\n• Dizer \"não sei\" e passar para um atendente\n• Guardar o histórico da conversa\n• Botão útil / não útil em cada resposta\n\nNão funcionais\n• Latência: 2 s para começar, 8 s no total (streaming)\n• Disponibilidade: 99,9%\n• LGPD: mascarar dados pessoais\n• Custo por conversa conhecido e acompanhado",
   "autoResize": false,
   "lineHeight": 1.25
  },
  {
   "id": "te12",
   "type": "text",
