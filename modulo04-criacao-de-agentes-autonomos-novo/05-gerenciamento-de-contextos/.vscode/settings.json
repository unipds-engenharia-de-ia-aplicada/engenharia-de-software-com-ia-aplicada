{
    "github.copilot.chat.agent.runTasks": true,
    "github.copilot.chat.codesearch.enabled": true,
    "github.copilot.chat.agent.terminalCommandExecution.allowed": [
        "npm run dev",
        "npm run arena",
        "npm run bench",
        "npm run typecheck",
        "npm test",
        "npm run *",
        "npx tsc",
        "node",
        "git status",
        "git diff",
        "git add",
        "git commit"
    ],
    "github.copilot.chat.agent.terminalCommandExecution.denied": [
        "rm -rf",
        "sudo",
        "git push --force",
        "git push -f",
        "cat .env",
        "less .env",
        "more .env",
        "head .env",
        "tail .env",
        "grep .env",
        "git push"
    ],
    "chat.promptFilesRecommendations": {
        "speckit.constitution": true,
        "speckit.specify": true,
        "speckit.plan": true,
        "speckit.tasks": true,
        "speckit.implement": true
    },
    "chat.tools.terminal.autoApprove": {
        ".specify/scripts/bash/": true,
        ".specify/scripts/powershell/": true
    }
}
